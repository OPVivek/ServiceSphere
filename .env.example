# ==============================================================================
# ServiceSphere - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local deployment.
# Never commit actual credentials or production secrets to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=servicesphere
DB_USERNAME=servicesphere
DB_PASSWORD=secretpassword

# Spring Boot Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# Security & JWT Configuration (Must be at least 256-bit / 32 bytes hex encoded)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80

# Demo Seeder Flag (true in development to populate realistic accounts, cases, and SLAs)
APP_SEED_DEMO_DATA=true

# Frontend Port Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
