# ServiceSphere Root .gitignore

# Dependencies & Compiled Files
node_modules/
dist/
dist-ssr/
*.local

# Java / Maven
backend/target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# IDE & Editor Configurations
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Environment & Secrets
.env
.env.production
*.pem
*.key

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database & Docker Volumes
postgres_data/
h2-data/
*.db
